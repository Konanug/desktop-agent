# ── Secrets: never commit ──────────────────────────────────────────────
*.env
.env
!.env.example
auth.json
*.token
*.key
*.pem
credentials.json

# ── Generated animation packs (rebuilt via `make frames`) ──────────────
assets/anim/*.pack
assets/anim/*.json

# ── Baseline/system backups (machine-specific, may contain host detail) ─
backup/

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ── Editor / OS ────────────────────────────────────────────────────────
.vscode/
*.swp
.DS_Store

# ── Google OAuth + the send-consent phrase (owner secrets, never in the repo)
google-client-secret.json
google-token.json
send-consent-phrase

# ── Belt and braces for a PUBLIC repo ──────────────────────────────────
# These live outside the tree by design (~/.hermes, ~/.config/hermes-pi),
# but a stray copy pasted in for debugging must never be committable.
*client_secret*.json
*google-token*.json
*-token
*.secret
send-consent-phrase
gestures.json
!clients/windows/gestures.example.json
asound.state

# Private worklog -- notes to the owner, not part of the project
HANDOFF.md
