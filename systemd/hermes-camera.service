[Unit]
Description=Hermes Pi Camera - exclusive sensor owner, serves capture requests
Documentation=file:///home/alanmyin/projects/hermes-pi/docs/CAMERA.md

# No Wants=, no After=, no Requires= on anything.
# The camera is independent of both other services by design: it must be
# stoppable as a privacy control without disturbing Discord, and a wedged
# sensor must never be able to take the gateway or the panel down with it.
# All three processes can die independently -- that is the property the whole
# system is built on.
#
# StartLimit* live HERE, in [Unit]. systemd only reads them from [Unit]; put
# them in [Service] and it logs "Unknown key ... ignoring" and the crash-loop
# guard silently does not exist. hermes-display.service had exactly that bug.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/alanmyin/projects/hermes-pi

# The cv-venv interpreter, NOT /usr/bin/python3. It is created with
# --system-site-packages by scripts/install-cv.sh, so picamera2, Pillow and the
# SYSTEM numpy 2.2.4 are all still the ones in use -- only mediapipe is added.
# Verified that pip did not shadow numpy; picamera2 breaks against a different
# one, and it would break at capture time rather than at import.
#
# If this venv is ever removed, hand tracking is the only thing that stops:
# camera/hands.py degrades to unavailable and everything else -- captures for
# Hermes, the ring buffer, the live stream -- carries on. /usr/bin/python3 -m
# camera also still works for testing by hand.
ExecStart=/home/alanmyin/.local/share/hermes-pi/cv-venv/bin/python -m camera

# libcamera logs several INFO lines to stderr on every configure(). Without
# this the journal fills with pipeline chatter and the one line that matters --
# the capture audit line -- gets buried.
Environment=LIBCAMERA_LOG_LEVELS=*:ERROR

# Live MJPEG view for a browser on the LAN (camera/stream.py). Defaults are in
# camera/protocol.py; every knob below is optional and shown at its default.
#
#   HERMES_CAMERA_STREAM=off          disable the server entirely
#   HERMES_CAMERA_STREAM_BIND=0.0.0.0 use 127.0.0.1 to require an ssh -L tunnel
#   HERMES_CAMERA_STREAM_PORT=8081
#   HERMES_CAMERA_STREAM_TOKEN=off    serve with NO token -- see docs/SECURITY.md
#
# This is the SECOND network-facing socket on this box; ssh was the only one
# before it. That is why the token is on by default and why turning it off
# takes an explicit setting rather than being the path of least resistance.
# Get the URL with:  python3 -m camera --stream-url

Restart=always
RestartSec=3

# Release the sensor cleanly rather than leaving it powered. The service
# closes the camera on SIGTERM; if it cannot, the kernel's 5s runtime-PM
# autosuspend eventually drops it anyway.
KillSignal=SIGTERM
TimeoutStopSec=10

# NOTE: MemoryMax= is deliberately absent -- it would be silently ignored.
# cgroup_disable=memory on the kernel cmdline means only cpuset/cpu/io/pids
# are available. Same reason as hermes-display.service.
#
# The quota exists so the camera can never starve the display, which is the
# service with a hard real-time-ish deadline (a late blit is a visible stutter).
#
# Raised from 60% when hand tracking landed. MEASURED components, per second,
# while a viewer is attached:
#     stream, 960 long edge at 15 fps   ~40% of one core
#     hand detection, ~60 ms at 10 Hz   ~60% of one core (its own thread)
# That is ~100% of ONE core, on a machine with four. 200% leaves genuine
# headroom rather than sitting on the limit, where the symptom would be a
# stream that stutters under throttling and looks like a network fault.
# Still Nice=5, so the display wins any contention regardless.
CPUQuota=200%
Nice=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
