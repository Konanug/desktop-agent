[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/alanmyin/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run
WorkingDirectory=/home/alanmyin/.hermes
Environment="PATH=/home/alanmyin/.hermes/hermes-agent/venv/bin:/home/alanmyin/.hermes/hermes-agent/node_modules/.bin:/home/alanmyin/.hermes/node/bin:/home/alanmyin/.hermes/node:/home/alanmyin/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/alanmyin/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/alanmyin/.hermes"
Restart=always
RestartSec=5
RestartForceExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStopPost=-/home/alanmyin/.hermes/hermes-agent/venv/bin/python -m gateway.cgroup_cleanup
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
